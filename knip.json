{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    "plugins": {
      "entry": [
        "**/index.{server,client}.{ts,tsx}",
        "**/*.test.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    ".": {
      "entry": [
        "scripts/**/*.{js,mjs,cjs,ts}"
      ],
      "project": [
        "scripts/**/*.{js,mjs,cjs,ts}"
      ]
    },
    "packages/server": {
      "entry": [
        "src/server/agent/agent-sdk-types.ts",
        "scripts/**/*.{ts,mts,mjs,cjs,js}",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mts,mjs,cjs,js}"
      ]
    },
    "packages/app": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "app.config.js",
        "babel.config.js",
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "playwright.config.{ts,js}",
        "vitest.config.{ts,js}",
        "test-stubs/**/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,js,jsx}"
      ],
      "paths": {
        "@server/*": [
          "../server/src/*"
        ]
      },
      "expo": false
    },
    "packages/cli": {
      "entry": [
        "src/index.ts",
        "bin/paseo",
        "src/**/*.test.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "packages/relay": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/desktop": {
      "entry": [
        "src/preload.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/highlight": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/expo-two-way-audio": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/client": {
      "entry": [
        "examples/**/*.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "examples/**/*.ts"
      ]
    },
    "packages/protocol": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreDependencies": [
    "sherpa-onnx-node",
    "@playwright/test",
    "material-icon-theme",
    "eas-cli",
    "wait-on",
    "get-port-cli",
    "patch-package",
    "buffer"
  ],
  "ignoreBinaries": [
    "xed",
    "eas",
    "wrangler",
    "powershell",
    "vitest",
    "open"
  ]
}
